{
  "name": "transnoa-viaticos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && npm run db:migrate:deploy && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:encoding": "node scripts/check-mojibake.mjs",
    "kit:check": "node scripts/ai-dev-kit/check.mjs",
    "kit:test": "node --test --test-concurrency=1 scripts/ai-dev-kit/check.test.mjs",
    "kit:ownership": "node scripts/ai-dev-kit/ownership-check.mjs",
    "kit:surfaces": "node scripts/ai-dev-kit/surfaces.mjs",
    "kit:ui-check": "node scripts/ai-dev-kit/ui-check.mjs",
    "kit:ui-check:strict": "node scripts/ai-dev-kit/ui-check.mjs --strict",
    "test:workflow": "node --test scripts/tests/workflow-rules.test.mjs scripts/tests/date-only.test.mjs scripts/tests/request-timeline.test.mjs",
    "postinstall": "prisma generate",
    "hooks:install": "node scripts/install-githooks.mjs",
    "prepare": "npm run hooks:install",
    "verify": "npm run kit:check && npm run check:encoding && npm run typecheck && npm run lint && npm run test:workflow && npm run test:deployment",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:push": "prisma db push",
    "db:migrate:deploy": "node scripts/prisma-migrate-deploy.mjs",
    "db:migrate:status": "prisma migrate status",
    "test:migration:fresh": "node scripts/verify-fresh-migration.mjs",
    "test:deployment": "node --test scripts/tests/prisma-migration-connection.test.mjs",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "next": "16.1.3",
    "prisma": "^5.22.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}

