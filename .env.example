# Contrato de entorno. No colocar secretos reales en este archivo.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/transnoa
# La integración Neon/Vercel expone esta conexión directa automáticamente.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_HOST:5432/transnoa
# Override opcional para pipelines que usan un nombre propio.
DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_HOST:5432/transnoa
